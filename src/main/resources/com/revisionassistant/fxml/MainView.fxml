<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.revisionassistant.controller.MainController"
           styleClass="app-shell">

    <children>
        <BorderPane styleClass="app-shell">

            <!-- SIDEBAR -->
            <left>
                <VBox fx:id="sidebar" prefWidth="214" minWidth="190" maxWidth="238"
                      spacing="0" styleClass="sidebar" BorderPane.alignment="CENTER">

                    <!-- Brand -->
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="brand-block">
                        <padding><Insets top="20" right="12" bottom="10" left="12"/></padding>
                        <Label text="RA" styleClass="brand-mark"/>
                        <VBox spacing="1">
                            <Label text="Revision Assistant" styleClass="brand-title"/>
                            <Label text="Focused study workspace" styleClass="brand-subtitle"/>
                        </VBox>
                    </HBox>

                    <!-- Navigation -->
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox spacing="4" fillWidth="true">
                                <padding><Insets top="4" right="12" bottom="8" left="12"/></padding>

                                <Label text="WORKSPACE" styleClass="nav-section-label"/>
                                <Button fx:id="dashboardButton" text="⌂   Dashboard" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showDashboard"/>
                                <Button fx:id="subjectsButton" text="▦   Subjects" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showSubjects"/>
                                <Button fx:id="topicsButton" text="◇   Topics" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showTopics"/>
                                <Button fx:id="tasksButton" text="✓   Study Planner" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showTasks"/>
                                <Button fx:id="examsButton" text="□   Exams" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showExams"/>
                                <Button fx:id="studySessionsButton" text="◷   Study Sessions" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showStudySessions"/>
                                <Button fx:id="studyPathButton" text="◈   My Study Path" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showStudyPath"/>

                                <Region minHeight="10"/>

                                <Label text="PRACTICE" styleClass="nav-section-label"/>
                                <Button fx:id="flashcardsButton" text="▤   Flashcards" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showFlashcards"/>
                                <Button fx:id="quizButton" text="?   Quiz" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showQuiz"/>

                                <Region minHeight="10"/>

                                <Label text="TOOLS" styleClass="nav-section-label"/>
                                <Button fx:id="studyToolsButton" text="✦   Study Tools" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showStudyTools"/>
                                <Button fx:id="pomodoroButton" text="⏱   Pomodoro" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showPomodoro"/>
                                <Button fx:id="mindMapButton" text="⬡   Mind Map" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showMindMap"/>
                                <Button fx:id="resourcesButton" text="🔗   Resources" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showResources"/>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <!-- Sidebar separator -->
                    <Separator styleClass="sidebar-separator"/>

                    <!-- Footer -->
                    <VBox spacing="4" styleClass="sidebar-footer">
                        <padding><Insets top="8" right="12" bottom="14" left="12"/></padding>
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="profile-placeholder">
                            <Label text="RA" styleClass="profile-mark"/>
                            <VBox spacing="1" HBox.hgrow="ALWAYS">
                                <Label fx:id="profileNameLabel" text="Study workspace" styleClass="profile-title"/>
                                <Label fx:id="profileEmailLabel" text="Local account" styleClass="profile-subtitle"/>
                            </VBox>
                        </HBox>
                        <Button fx:id="settingsButton" text="⚙   Settings" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showSettings"/>
                        <Button text="↩  Tour" maxWidth="Infinity" styleClass="sidebar-button" onAction="#handleReplayTour"/>
                        <Button text="Log out" maxWidth="Infinity" styleClass="sidebar-button sidebar-logout" onAction="#handleLogout"/>
                    </VBox>
                </VBox>
            </left>

            <!-- TOP BAR -->
            <top>
                <HBox  alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">
                    <padding><Insets top="13" right="20" bottom="13" left="22"/></padding>
                    <VBox spacing="2">
                        <Label fx:id="pageTitleLabel" text="Dashboard" styleClass="page-title"/>
                        <Label fx:id="pageSubtitleLabel" text="A calm place to plan, practise, and review." styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Revision Assistant" styleClass="header-context"/>
                    <StackPane styleClass="notification-bell-wrap">
                        <Button fx:id="notificationBellButton" text="🔔" onAction="#handleShowNotifications" styleClass="notification-bell-button"/>
                        <Label fx:id="notificationBadge" text="0" visible="false" mouseTransparent="true" styleClass="notification-badge"/>
                    </StackPane>
                </HBox>
            </top>

            <!-- MAIN CONTENT -->
            <center>
                <StackPane fx:id="contentArea" styleClass="content-area" BorderPane.alignment="CENTER"/>
            </center>
        </BorderPane>

        <!-- NOTIFICATION TOAST LAYER -->
        <StackPane fx:id="notificationLayer" mouseTransparent="true" pickOnBounds="false" styleClass="notification-layer"/>

        <!-- FEATURE TOUR OVERLAY -->
        <StackPane fx:id="tourOverlay" visible="false" managed="false" mouseTransparent="true" pickOnBounds="true" styleClass="tour-overlay"/>
    </children>
</StackPane>
