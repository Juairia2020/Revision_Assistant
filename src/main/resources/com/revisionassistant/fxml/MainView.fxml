<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.revisionassistant.controller.MainController"
            styleClass="app-shell">
    <children>
    <BorderPane styleClass="app-shell">
    <left>
        <VBox fx:id="sidebar" prefWidth="214" minWidth="190" maxWidth="238"
              spacing="4" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="12" bottom="16" left="12"/>
            </padding>
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="brand-block">
                    <Label text="RA" styleClass="brand-mark"/>
                    <VBox spacing="1">
                        <Label text="Revision Assistant" styleClass="brand-title"/>
                        <Label text="Focused study workspace" styleClass="brand-subtitle"/>
                    </VBox>
                </HBox>

                <Region minHeight="18"/>
                <Label text="WORKSPACE" styleClass="nav-section-label"/>

                <Button fx:id="dashboardButton" text="⌂   Dashboard" maxWidth="Infinity"
                        styleClass="sidebar-button" onAction="#showDashboard"/>
                <Button fx:id="subjectsButton" text="▦   Subjects" maxWidth="Infinity"
                        styleClass="sidebar-button" onAction="#showSubjects"/>
                <Button fx:id="topicsButton" text="◇   Topics" maxWidth="Infinity"
                        styleClass="sidebar-button" onAction="#showTopics"/>
                <Button fx:id="tasksButton" text="✓   Study Planner" maxWidth="Infinity"
                        styleClass="sidebar-button" onAction="#showTasks"/>
                <Button fx:id="examsButton" text="□   Exams" maxWidth="Infinity"
                        styleClass="sidebar-button" onAction="#showExams"/>
                <Button fx:id="studySessionsButton" text="◷   Study Sessions" maxWidth="Infinity"
                        styleClass="sidebar-button" onAction="#showStudySessions"/>

                <Region minHeight="10"/>
                <Label text="PRACTICE" styleClass="nav-section-label"/>

                <Button fx:id="flashcardsButton" text="▤   Flashcards" maxWidth="Infinity"
                        styleClass="sidebar-button" onAction="#showFlashcards"/>
                <Button fx:id="quizButton" text="?   Quiz" maxWidth="Infinity"
                        styleClass="sidebar-button" onAction="#showQuiz"/>
                <Button fx:id="studyToolsButton" text="✦   Study Tools" maxWidth="Infinity"
                        styleClass="sidebar-button" onAction="#showStudyTools"/>

                <Region VBox.vgrow="ALWAYS"/>
                <Separator styleClass="sidebar-separator"/>
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="profile-placeholder">
                    <Label text="RA" styleClass="profile-mark"/>
                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label fx:id="profileNameLabel" text="Study workspace" styleClass="profile-title"/>
                        <Label fx:id="profileEmailLabel" text="Local account" styleClass="profile-subtitle"/>
                    </VBox>
                </HBox>
                <Button text="Take Feature Tour" maxWidth="Infinity" styleClass="sidebar-button" onAction="#handleReplayTour"/>
                <Button text="Log out" maxWidth="Infinity" styleClass="sidebar-button sidebar-logout" onAction="#handleLogout"/>
            </children>
        </VBox>
    </left>

    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">
            <padding>
                <Insets top="13" right="20" bottom="13" left="22"/>
            </padding>
            <children>
                <VBox spacing="2">
                    <Label fx:id="pageTitleLabel" text="Dashboard" styleClass="page-title"/>
                    <Label fx:id="pageSubtitleLabel" text="A calm place to plan, practise, and review." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Revision Assistant" styleClass="header-context"/>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" BorderPane.alignment="CENTER"/>
    </center>
</BorderPane>
        <StackPane fx:id="tourOverlay" visible="false" managed="false" styleClass="tour-overlay"/>
    </children>
</StackPane>
