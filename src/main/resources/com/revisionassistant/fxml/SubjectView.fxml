<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.revisionassistant.controller.SubjectController">
    <top>
        <VBox spacing="10" styleClass="view-header" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16" right="16" bottom="10" left="16"/>
            </padding>
            <children>
                <Label text="Subjects" styleClass="view-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="nameField" promptText="Subject name" prefWidth="220"/>
                        <ColorPicker fx:id="colorPicker"/>
                        <Button text="Add" onAction="#handleAdd" styleClass="primary-button"/>
                        <Button text="Update" onAction="#handleEdit" styleClass="secondary-button"/>
                        <Button text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <ListView fx:id="subjectsList" BorderPane.alignment="CENTER" styleClass="feature-list">
            <BorderPane.margin><Insets top="0" right="16" bottom="16" left="16"/></BorderPane.margin>
        </ListView>
    </center>
</BorderPane>
