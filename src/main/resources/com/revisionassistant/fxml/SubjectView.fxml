<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.revisionassistant.controller.SubjectController">
    <top>
        <VBox spacing="12" styleClass="view-header" BorderPane.alignment="CENTER">
            <padding><Insets top="16" right="16" bottom="12" left="16"/></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="countCaptionLabel" text="Subjects" styleClass="row-meta"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="action-bar">
                    <children>
                        <VBox spacing="4" styleClass="action-group">
                            <Label text="SUBJECT" styleClass="action-caption"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="nameField" promptText="Subject name" prefWidth="260"/>
                                <ColorPicker fx:id="colorPicker"/>
                            </HBox>
                        </VBox>
                        <Region styleClass="action-divider"/>
                        <VBox spacing="4" styleClass="action-group">
                            <Label text="ACTIONS" styleClass="action-caption"/>
                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="action-footer">
                                <Button text="Add" onAction="#handleAdd" styleClass="primary-button"/>
                                <Button text="Update" onAction="#handleEdit" styleClass="secondary-button"/>
                            </HBox>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll" BorderPane.alignment="CENTER">
            <content>
                <FlowPane fx:id="subjectsGrid" hgap="14" vgap="14" styleClass="page-content">
                    <padding><Insets top="4" right="16" bottom="24" left="16"/></padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
