<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.revisionassistant.controller.FeatureTourController"
           styleClass="tour-backdrop">
    <children>
        <VBox fx:id="tourCard" maxWidth="540" maxHeight="360" spacing="18" styleClass="tour-card">
            <padding>
                <Insets top="30" right="32" bottom="26" left="32"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="stepLabel" text="Welcome" styleClass="tour-eyebrow"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="progressLabel" text="Step 1 of 9" styleClass="tour-progress"/>
                </HBox>
                <VBox spacing="7">
                    <Label fx:id="titleLabel" text="Welcome to Revision Assistant" wrapText="true" styleClass="tour-title"/>
                    <Label fx:id="descriptionLabel" text="Let's take a quick tour of your new study workspace." wrapText="true" styleClass="tour-description"/>
                </VBox>
                <Region VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Button fx:id="skipButton" text="Skip Tour" styleClass="link-button" onAction="#handleSkip"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="previousButton" text="Previous" styleClass="secondary-button" onAction="#handlePrevious"/>
                    <Button fx:id="nextButton" text="Next" styleClass="primary-button" onAction="#handleNext"/>
                    <Button fx:id="finishButton" text="Start Studying" visible="false" managed="false" styleClass="primary-button" onAction="#handleFinish"/>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
