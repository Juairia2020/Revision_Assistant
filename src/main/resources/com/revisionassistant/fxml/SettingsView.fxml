<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.revisionassistant.controller.SettingsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <content>
        <VBox spacing="18" styleClass="settings-page">
            <fx:define>
                <ToggleGroup fx:id="themeToggleGroup"/>
                <ToggleGroup fx:id="fontSizeGroup"/>
            </fx:define>
            <padding><Insets top="20" right="26" bottom="32" left="26"/></padding>

            <VBox spacing="12" styleClass="settings-card">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="JD" styleClass="settings-avatar"/>
                    <VBox spacing="3" VBox.vgrow="ALWAYS">
                        <Label fx:id="profileNameLabel" text="User" styleClass="settings-profile-name"/>
                        <Label fx:id="profileEmailLabel" text="email@example.com" styleClass="settings-profile-email"/>
                    </VBox>
                    <Label text="Account settings" styleClass="settings-chip"/>
                </HBox>
            </VBox>

            <VBox spacing="12" styleClass="settings-card">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Appearance" styleClass="settings-section-title"/>
                <Label text="Choose how the study workspace should look. Changes apply immediately." styleClass="settings-help" wrapText="true"/>

                <VBox spacing="8">
                    <Label text="Theme" styleClass="settings-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <RadioButton fx:id="lightThemeRadio" text="Light" toggleGroup="$themeToggleGroup" styleClass="settings-choice"/>
                        <RadioButton fx:id="darkThemeRadio" text="Dark" toggleGroup="$themeToggleGroup" styleClass="settings-choice"/>
                        <Button text="Apply Theme" onAction="#handleApplyTheme" styleClass="secondary-button settings-theme-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="8">
                    <Label text="Font Size" styleClass="settings-label"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <RadioButton fx:id="fontMediumRadio" text="Medium" toggleGroup="$fontSizeGroup" styleClass="settings-choice"/>
                        <RadioButton fx:id="fontLargeRadio" text="Large" toggleGroup="$fontSizeGroup" styleClass="settings-choice"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox spacing="12" styleClass="settings-card">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Notifications &amp; Reminders" styleClass="settings-section-title"/>
                <Label text="Date-based reminders are sent the day before the event. They appear in the app and as native desktop notifications while Revision Assistant is running in the background or minimized." styleClass="settings-help" wrapText="true"/>
                <CheckBox fx:id="studyRemindersCheck" text="Study session reminders" styleClass="settings-check"/>
                <CheckBox fx:id="examRemindersCheck" text="Exam countdown reminders" styleClass="settings-check"/>
                <CheckBox fx:id="achievementCheck" text="Achievement / progress milestone notifications" styleClass="settings-check"/>
                <CheckBox fx:id="streakCheck" text="Study streak alerts" styleClass="settings-check"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Want to verify the enabled reminders?" styleClass="settings-help" HBox.hgrow="ALWAYS" wrapText="true"/>
                    <Button text="Test selected reminders" onAction="#handleTestReminders" styleClass="secondary-button"/>
                </HBox>
            </VBox>

            <VBox spacing="12" styleClass="settings-card">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Pomodoro Timer" styleClass="settings-section-title"/>
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="220" halignment="LEFT"/>
                        <ColumnConstraints minWidth="110" halignment="LEFT"/>
                    </columnConstraints>
                    <Label text="Focus duration (minutes)" styleClass="settings-label" GridPane.rowIndex="0"/>
                    <TextField fx:id="pomoDurationField" prefWidth="100" GridPane.columnIndex="1"/>
                    <Label text="Short break (minutes)" styleClass="settings-label" GridPane.rowIndex="1"/>
                    <TextField fx:id="pomoShortBreakField" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Long break (minutes)" styleClass="settings-label" GridPane.rowIndex="2"/>
                    <TextField fx:id="pomoLongBreakField" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>

            <VBox spacing="12" styleClass="settings-card">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <Label text="Study Data" styleClass="settings-section-title"/>
                <Label text="Clear topic completion status while keeping your subjects and topics." styleClass="settings-help" wrapText="true"/>
                <Button text="Clear Study Path Data" styleClass="danger-button" onAction="#handleResetStudyData"/>
            </VBox>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Label fx:id="saveStatusLabel" text="Changes are stored per user." styleClass="settings-save-status" HBox.hgrow="ALWAYS" wrapText="true"/>
                <Button text="Save Preferences" styleClass="primary-button settings-save-button" onAction="#handleSavePreferences"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
