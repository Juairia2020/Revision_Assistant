<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.revisionassistant.controller.StudyToolsController">
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <!-- Workbench 1: inspect a topic; results side by side -->
                <Tab text="Topic Dependencies">
                    <content>
                        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
                            <content>
                                <VBox spacing="16" styleClass="page-content">
                                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                    <children>
                                        <VBox spacing="10" styleClass="action-bar">
                                            <children>
                                                <HBox spacing="14" alignment="CENTER_LEFT">
                                                    <VBox spacing="4" styleClass="action-group">
                                                        <Label text="INSPECT A TOPIC" styleClass="action-caption"/>
                                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                                            <ComboBox fx:id="subjectComboBox" promptText="Subject" prefWidth="180"/>
                                                            <ComboBox fx:id="topicComboBox" promptText="Topic" prefWidth="200"/>
                                                        </HBox>
                                                    </VBox>
                                                    <Region styleClass="action-divider"/>
                                                    <VBox spacing="4" styleClass="action-group">
                                                        <Label text="ANALYSE" styleClass="action-caption"/>
                                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                                            <Button text="Suggested Study Order" onAction="#handleShowStudyOrder" styleClass="secondary-button"/>
                                                            <Button text="Check Dependencies" onAction="#handleCheckCycles" styleClass="secondary-button"/>
                                                        </HBox>
                                                    </VBox>
                                                    <Region styleClass="action-divider"/>
                                                    <VBox spacing="4" styleClass="action-group">
                                                        <Label text="ADD PREREQUISITE" styleClass="action-caption"/>
                                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                                            <ComboBox fx:id="prerequisiteComboBox" promptText="Prerequisite topic" prefWidth="220"/>
                                                            <Button text="Add Prerequisite" onAction="#handleAddPrerequisite" styleClass="primary-button"/>
                                                        </HBox>
                                                    </VBox>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <HBox spacing="16" VBox.vgrow="ALWAYS">
                                            <children>
                                                <VBox spacing="8" styleClass="panel" HBox.hgrow="ALWAYS" minHeight="320">
                                                    <children>
                                                        <Label text="Prerequisites (what this topic requires)" styleClass="panel-title"/>
                                                        <VBox fx:id="prerequisitesBox" spacing="6"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="8" styleClass="panel" HBox.hgrow="ALWAYS" minHeight="320">
                                                    <children>
                                                        <Label text="Dependents (what requires this topic)" styleClass="panel-title"/>
                                                        <VBox fx:id="dependentsBox" spacing="6"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
                <!-- Workbench 2: planner; control strip + generated plan as the main focus -->
            </tabs>
        </TabPane>
    </center>
</BorderPane>
