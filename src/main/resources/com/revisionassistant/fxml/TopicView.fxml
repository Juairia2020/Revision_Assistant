<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.revisionassistant.controller.TopicController">
    <top>
        <VBox spacing="12" styleClass="view-header" BorderPane.alignment="CENTER">
            <padding><Insets top="16" right="16" bottom="12" left="16"/></padding>
            <children>
                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="action-bar">
                    <children>
                        <VBox spacing="4" styleClass="action-group" HBox.hgrow="ALWAYS">
                            <Label text="TOPIC" styleClass="action-caption"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ComboBox fx:id="subjectComboBox" promptText="Subject" prefWidth="190"/>
                                <TextField fx:id="topicNameField" promptText="Topic name" prefWidth="240" HBox.hgrow="ALWAYS"/>
                                <CheckBox fx:id="completedCheckBox" text="Completed (set from Study Path)"/>
                            </HBox>
                        </VBox>
                        <Region styleClass="action-divider"/>
                        <VBox spacing="4" styleClass="action-group">
                            <Label text="ACTIONS" styleClass="action-caption"/>
                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="action-footer">
                                <Button text="Add" onAction="#handleAddTopic" styleClass="primary-button"/>
                                <Button text="Update" onAction="#handleEditTopic" styleClass="secondary-button"/>
                            </HBox>
                        </VBox>
                        <Region styleClass="action-divider"/>
                        <Button text="Delete" onAction="#handleDeleteTopic" styleClass="danger-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <ListView fx:id="topicsList" BorderPane.alignment="CENTER" styleClass="feature-list">
            <BorderPane.margin><Insets top="0" right="16" bottom="16" left="16"/></BorderPane.margin>
        </ListView>
    </center>
</BorderPane>
