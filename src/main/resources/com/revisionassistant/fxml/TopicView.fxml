<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.revisionassistant.controller.TopicController">
    <top>
        <VBox spacing="10" styleClass="view-header" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16" right="16" bottom="10" left="16"/>
            </padding>
            <children>
                <Label text="Topics" styleClass="view-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Subject:"/>
                        <ComboBox fx:id="subjectComboBox" prefWidth="180"/>
                        <TextField fx:id="topicNameField" promptText="Topic name" prefWidth="220"/>
                        <CheckBox fx:id="completedCheckBox" text="Completed"/>
                    </children>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Button text="Add" onAction="#handleAddTopic" styleClass="primary-button"/>
                        <Button text="Update" onAction="#handleEditTopic"/>
                        <Button text="Delete" onAction="#handleDeleteTopic" styleClass="danger-button"/>
                        <Button text="Mark Completed" onAction="#handleMarkCompleted"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="topicsTable" editable="true" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="260"/>
                <TableColumn fx:id="completedColumn" text="Completed" prefWidth="100"/>
            </columns>
            <BorderPane.margin>
                <Insets top="0" right="16" bottom="16" left="16"/>
            </BorderPane.margin>
        </TableView>
    </center>
</BorderPane>
