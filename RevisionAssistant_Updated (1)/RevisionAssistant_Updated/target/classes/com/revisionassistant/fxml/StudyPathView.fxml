<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.revisionassistant.controller.StudyPathController"
      styleClass="view-root"
      spacing="0">

    <!-- Header bar -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="view-toolbar">
        <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
        <VBox spacing="2">
            <Label text="My Study Path" styleClass="view-title"/>
            <Label fx:id="statsLabel" text="Loading..." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="subjectFilterCombo" prefWidth="180"/>
        <Button text="↻  Refresh" onAction="#refresh" styleClass="primary-button"/>
    </HBox>

    <!-- Overall progress bar -->
    <VBox spacing="6" styleClass="path-progress-header">
        <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Overall Progress" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="overallProgressLabel" text="0%" styleClass="path-overall-percent"/>
        </HBox>
        <ProgressBar fx:id="overallProgressBar" maxWidth="Infinity" progress="0" styleClass="path-overall-bar"/>
    </VBox>

    <!-- Legend -->
    <HBox fx:id="legendBox" spacing="20" alignment="CENTER_LEFT" styleClass="path-legend">
        <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="✓" styleClass="legend-done-dot"/>
            <Label text="Completed" styleClass="row-meta"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="●" styleClass="legend-current-dot"/>
            <Label text="Study Now" styleClass="row-meta"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="○" styleClass="legend-upcoming-dot"/>
            <Label text="Upcoming" styleClass="row-meta"/>
        </HBox>
    </HBox>

    <!-- Scrollable path -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
        <content>
            <VBox spacing="0">
                <padding><Insets top="8" right="16" bottom="20" left="16"/></padding>
                <VBox fx:id="pathContainer" spacing="12"/>
                <Label fx:id="emptyStateLabel"
                       text="No subjects yet. Add a subject and topics in the Subjects and Topics sections, then come back to see your study path."
                       styleClass="empty-state" wrapText="true" visible="true" managed="true">
                    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
                </Label>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
