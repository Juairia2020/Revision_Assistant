<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.revisionassistant.controller.TopicController">
    <top>
        <VBox spacing="10" styleClass="view-header" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16" right="16" bottom="10" left="16"/>
            </padding>
            <children>
                <Label text="Topics" styleClass="view-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Subject:"/>
                        <ComboBox fx:id="subjectComboBox" prefWidth="180"/>
                        <TextField fx:id="topicNameField" promptText="Topic name" prefWidth="220"/>
                        <CheckBox fx:id="completedCheckBox" text="Completed (set from Study Path)"/>
                    </children>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Button text="Add" onAction="#handleAddTopic" styleClass="primary-button"/>
                        <Button text="Update" onAction="#handleEditTopic" styleClass="secondary-button"/>
                        <Button text="Delete" onAction="#handleDeleteTopic" styleClass="danger-button"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <ListView fx:id="topicsList" BorderPane.alignment="CENTER" styleClass="feature-list">
            <BorderPane.margin><Insets top="0" right="16" bottom="16" left="16"/></BorderPane.margin>
        </ListView>
    </center>
</BorderPane>
